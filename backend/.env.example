# AgriConnect Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB Atlas Connection (recommended for production/deployment)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.a2i4y25.mongodb.net/agriconnect?retryWrites=true&w=majority
MONGODB_USERNAME=<your_atlas_username>
MONGODB_PASSWORD=<your_atlas_password>

# JWT Secret - Use a long random string in production!
JWT_SECRET=your_secure_random_jwt_secret_key_here_change_in_production

# Environment
NODE_ENV=production
